#!/usr/bin/env php
<?php

namespace SismaFramework\Console;

use SismaFramework\Console\HelperClasses\CommandDispatcher;
use SismaFramework\Console\HelperClasses\CommandLineInterfaceSettingsChecker;
use SismaFramework\Core\HelperClasses\Config;
use SismaFramework\Core\HelperClasses\ErrorHandler;

$projectBootstrap = dirname(__DIR__, 2) . DIRECTORY_SEPARATOR . 'Config' . DIRECTORY_SEPARATOR . 'bootstrap.php';
$projectConfig = dirname(__DIR__, 2) . DIRECTORY_SEPARATOR . 'Config' . DIRECTORY_SEPARATOR . 'configFramework.php';
if (file_exists($projectBootstrap)) {
    require_once $projectBootstrap;
} elseif (file_exists($projectConfig)) {
    file_put_contents('php://stderr', "Deprecated: Config/bootstrap.php not found, loading Config/configFramework.php directly. This fallback will be removed in 13.0.0: create Config/bootstrap.php in the project root." . PHP_EOL);
    require_once $projectConfig;
} else {
    require_once dirname(__DIR__, 1) . DIRECTORY_SEPARATOR . 'Config' . DIRECTORY_SEPARATOR . 'bootstrap.php';
}
require_once dirname(__DIR__, 1) . DIRECTORY_SEPARATOR . 'Autoload' . DIRECTORY_SEPARATOR . 'autoload.php';

ErrorHandler::enableErrorDisplay();
date_default_timezone_set('Europe/Rome');

try {
    ErrorHandler::handleCommandLineInterfaceNonThrowableError();
    CommandLineInterfaceSettingsChecker::checkIsCommandLineInterfaceMode(php_sapi_name());
    CommandLineInterfaceSettingsChecker::checkIsProjectDirectory(Config::getInstance()->systemPath);
    $commandDispatcher = new CommandDispatcher(array_slice($argv, 1));
    exit($commandDispatcher->run() ? 0 : 1);
} catch (\Throwable $e) {
    echo "Error: " . $e->getMessage() . PHP_EOL;
    exit(1);
}
